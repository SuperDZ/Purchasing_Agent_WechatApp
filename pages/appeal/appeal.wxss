page, .appeal-page { background: #f7f7f7; min-height: 100vh; }
.section { margin: 20rpx; background: #fff; padding: 20rpx; border-radius: 12rpx; }
.label { display: block; margin-bottom: 12rpx; color: #666; }
.reason-input { min-height: 240rpx; width: 100%; border: 1rpx solid #e5e5e5; border-radius: 8rpx; padding: 12rpx; box-sizing: border-box; }
.footer { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; padding: 20rpx; display: flex; gap: 20rpx; justify-content: space-between; box-shadow: 0 -2rpx 8rpx rgba(0,0,0,.08); }
.submit { background: #1677ff; color: #fff; border: none; border-radius: 10rpx; }
.submit::after { border: none; }
