/* pages/index/index.wxss */

/* 整体页面背景和基本布局 */
page {
    background-color: #f5f5f5;
    height: 100%;
  }
  
  .container {
    padding: 20rpx;
    padding-bottom: calc(120rpx + env(safe-area-inset-bottom)); /* 适配 iPhone X 等异形屏底部安全区 */
    min-height: calc(100vh - 120rpx); /* 减去底部导航高度 */
    box-sizing: border-box;
  }
  
  .app-header {
    background: linear-gradient(to right, #ff7e5f, #feb47b); /* 美观的渐变背景 */
    color: white;
    padding: 30rpx 20rpx;
    border-radius: 16rpx;
    margin-bottom: 20rpx;
    text-align: center;
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  }
  
  .header-title {
    font-size: 36rpx;
    font-weight: bold;
    display: block;
    margin-bottom: 10rpx;
  }
  
  .header-subtitle {
    font-size: 28rpx;
    opacity: 0.9;
  }
  
  
  /* 内容区域 - 默认隐藏，只显示当前 Tab */
  .content-section {
    display: none;
    height: calc(100vh - 120rpx - 140rpx - 40rpx - env(safe-area-inset-bottom)); /* 视口高度 - 底部导航 - 头部 - 上下padding */
    flex-direction: column;
    background-color: white;
    border-radius: 16rpx;
    overflow: hidden;
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  }
  
  .content-section.active {
    display: flex;
    flex-direction: column;
  }
  
  
  /* --- 商品部分样式 --- */
  /* 搜索栏 */
  .search-section {
    padding: 20rpx;
    border-bottom: 1rpx solid #eee;
  }
  
  .search-bar {
    display: flex;
    gap: 10rpx;
  }
  
  .search-input {
    flex: 1;
    padding: 15rpx 20rpx;
    border: 1rpx solid #ddd;
    border-radius: 10rpx;
    font-size: 28rpx;
    background-color: #fafafa;
  }
  
  .search-button {
    padding: 15rpx 25rpx;
    background-color: #4ecdc4;
    color: white;
    border: none;
    border-radius: 10rpx;
    font-size: 28rpx;
    white-space: nowrap;
  }
  
/* --- 商品内容区域容器 --- */
.content-container {
    display: flex;
    flex-direction: row;
    height: calc(100vh - 200rpx); /* 大概估算，需根据 header/nav 高度调整 */
    margin-top: 20rpx;
    background-color: #f5f5f5;
    border-radius: 20rpx;
    overflow: hidden; /* 防止子元素溢出圆角 */
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1); /* 可选：增加一点阴影效果 */
  }
  
/* --- 左侧分类栏 --- */
.category-sidebar {
    width: 180rpx; /* 固定宽度 */
    background-color: #ffffff;
    border-right: 1rpx solid #e0e0e0;
  }
  
  .category-item {
    padding: 30rpx 20rpx;
    font-size: 28rpx;
    text-align: center;
    border-bottom: 1rpx solid #f0f0f0;
    transition: background-color 0.3s ease;
  }
  
  .category-item:last-child {
    border-bottom: none;
  }
  
  .category-item.active {
    background-color: #e3f2fd;
    color: #1976d2;
    font-weight: bold;
  }
  
  .category-item:hover { /* PC端预览时有用 */
    background-color: #f5f5f5;
    cursor: pointer;
  }
  
  
  /* --- 右侧商品网格容器 --- */
  .product-grid-container {
    flex: 1; /* 占据剩余空间 */
    padding: 20rpx;
    background-color: #fafafa;
  }
  
  
  /* --- 商品网格 --- */
  .product-grid {
    display: flex;
    flex-wrap: wrap; /* 关键：允许换行 */
    gap: 20rpx; /* 控制卡片之间的间距 */
    justify-content: flex-start; /* 可选：控制对齐方式 */
  }
  
  
/* --- 商品卡片 --- */
.product-card {
    /* 关键：使用 flex-basis 和 max-width 实现响应式 */
    flex: 1 1 calc(50% - 10rpx); /* 默认占据 50% 宽度 (减去部分 gap 的影响) */
    max-width: calc(50% - 10rpx); /* 限制最大宽度 */
    min-width: 280rpx; /* 设置最小宽度，防止过窄 */
    
    background-color: #ffffff;
    border-radius: 16rpx;
    overflow: hidden;
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  
  .product-card:hover { /* PC端预览时有用 */
    transform: translateY(-4rpx);
    box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.1);
  }
  
 /* --- 商品图片 --- */
.product-image {
    width: 100%;
    height: 280rpx; /* 固定高度或使用 aspect-ratio */
    /* aspect-ratio: 1; */ /* CSS 新特性，小程序兼容性需测试 */
    object-fit: cover; /* 保持比例填充 */
  }
  
  
  /* --- 商品信息 --- */
  .product-info {
    padding: 20rpx;
  }
  
  .product-title {
    display: block;
    font-size: 30rpx;
    font-weight: bold;
    margin-bottom: 10rpx;
    color: #333;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap; /* 或者设置为 normal 并限制行数 */
  }
  
  .product-description {
    display: block;
    font-size: 24rpx;
    color: #666;
    margin-bottom: 15rpx;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2; /* 限制显示两行 */
    -webkit-box-orient: vertical;
    word-break: break-word; /* 防止单词过长溢出 */
  }
  
  
  /* --- 商品价格行 (商品列表) --- */
.product-price-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 10rpx;
  }
  
  .product-price {
    font-size: 32rpx;
    font-weight: bold;
    color: #e53935;
  }
  
  /* 新增：商品加号按钮 (圆形) */
  .add-to-cart-btn {
    width: 40rpx;
    height: 40rpx;
    line-height: 40rpx;
    font-size: 28rpx;
    font-weight: bold;
    background-color: #1976d2;
    color: white;
    border: none;
    border-radius: 50%; /* 关键：圆形 */
    display: flex;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    transition: background-color 0.3s ease;
    margin-left: 10rpx; /* 紧贴价格右侧 */
  }
  
  .add-to-cart-btn:active {
    background-color: #1565c0;
  }
  /* --- 媒体查询：针对更小的屏幕 (例如 iPhone SE 等) 强制单列 --- */
  @media screen and (max-width: 600px) {
    .product-card {
      flex: 1 1 100%; /* 强制占满一行 */
      max-width: 100%; /* 移除最大宽度限制 */
    }
  }
  /* --- 购物车部分样式 --- */
  .cart-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 25rpx 30rpx;
    border-bottom: 1rpx solid #eee;
    background-color: #fffaf0; /* 浅橙色背景区分 */
  }
  
  .cart-title {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
  }
  
  .cart-summary {
    font-size: 26rpx;
    color: #888;
  }
  
  .cart-items-container {
    flex: 1; /* 占据剩余空间 */
  }
  
  .cart-items {
    padding: 0 20rpx;
  }
  
  .cart-item {
    display: flex;
    align-items: center;
    padding: 25rpx 0;
    border-bottom: 1rpx solid #f5f5f5;
  }
  
  .cart-item-info {
    flex: 2;
    min-width: 0; /* 防止内部文本溢出 */
  }
  
  .cart-item-name {
    font-size: 28rpx;
    font-weight: 500;
    display: block;
    margin-bottom: 8rpx;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  
  .cart-item-price {
    font-size: 26rpx;
    color: #666;
  }
  
  .cart-item-controls {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 15rpx;
  }
  
  .quantity-btn {
    width: 50rpx;
    height: 50rpx;
    padding: 0;
    background-color: #f0f0f0;
    border: 1rpx solid #ddd;
    border-radius: 50%;
    font-size: 28rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  
  .quantity-display {
    font-size: 28rpx;
    min-width: 50rpx;
    text-align: center;
  }
  
  .remove-btn {
    width: 50rpx;
    height: 50rpx;
    padding: 0;
    background-color: #ffcccc;
    border: 1rpx solid #ff9999;
    border-radius: 50%;
    color: #cc0000;
    font-size: 32rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  
  .cart-item-total {
    flex: 1;
    text-align: right;
    font-size: 28rpx;
    font-weight: bold;
    color: #333;
  }
  
  .cart-footer {
    padding: 20rpx 30rpx;
    border-top: 1rpx solid #eee;
    background-color: white;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .cart-total {
    display: flex;
    align-items: baseline;
    gap: 10rpx;
  }
  
  .cart-total text:first-child {
    font-size: 28rpx;
    color: #666;
  }
  
  .total-amount {
    font-size: 36rpx !important;
    font-weight: bold;
    color: #ff6b6b !important;
  }
  
  .checkout-button {
    padding: 18rpx 35rpx;
    background-color: #ff6b6b;
    color: white;
    border: none;
    border-radius: 10rpx;
    font-size: 30rpx;
    font-weight: bold;
    box-shadow: 0 4rpx 8rpx rgba(255, 107, 107, 0.3);
  }
  
  
  /* --- 订单部分样式 --- */
  .orders-header {
    padding: 25rpx 30rpx;
    border-bottom: 1rpx solid #eee;
    background-color: #f0f8ff; /* 浅蓝色背景区分 */
  }
  
  .orders-title {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
  }
  
  .orders-container {
    flex: 1; /* 占据剩余空间 */
  }
  
  .order-list {
    padding: 0 20rpx 20rpx 20rpx;
  }
  
  .order-item {
    background-color: white;
    border-radius: 12rpx;
    padding: 25rpx;
    margin-bottom: 25rpx;
    box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  }
  
  .order-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 20rpx;
    padding-bottom: 15rpx;
    border-bottom: 1rpx dashed #eee;
  }
  
  .order-id {
    font-size: 26rpx;
    font-weight: bold;
    color: #333;
  }
  
  .order-date {
    font-size: 24rpx;
    color: #888;
  }
  
  .order-products {
    margin-bottom: 20rpx;
  }
  
  .order-product {
    display: flex;
    justify-content: space-between;
    margin-bottom: 15rpx;
    font-size: 26rpx;
  }
  
  .product-name {
    flex: 2;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  
  .product-details {
    flex: 1;
    text-align: center;
    color: #666;
  }
  
  .product-subtotal {
    flex: 1;
    text-align: right;
    font-weight: 500;
  }
  
  .order-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 15rpx;
    border-top: 1rpx solid #f5f5f5;
  }
  
  .order-total {
    font-size: 28rpx;
    font-weight: bold;
    color: #333;
  }
  
  .order-status {
    font-size: 26rpx;
    font-weight: bold;
    padding: 5rpx 15rpx;
    border-radius: 8rpx;
  }
  
  .status-pending {
    color: #ff9900;
    background-color: #fff5e6;
  }
  
  .status-shipped {
    color: #4ecdc4;
    background-color: #e6fffa;
  }
  
  .status-completed {
    color: #52c41a;
    background-color: #f6ffed;
  }
  
  
  /* --- 底部导航栏样式 --- */
  .bottom-nav {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    display: flex;
    height: 120rpx; /* 60px */
    background-color: white;
    box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.1);
    z-index: 1000;
    padding-bottom: env(safe-area-inset-bottom); /* 适配 iPhone X 底部安全区 */
  }
  
  .nav-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #7A7E83;
    font-size: 24rpx;
    transition: color 0.3s ease;
  }
  
  .nav-item.active {
    color: #ff6b6b;
  }
  
  .nav-icon {
    font-size: 36rpx;
    margin-bottom: 6rpx;
  }
  
  
  /* --- 通用辅助样式 --- */
  .empty-state {
    text-align: center;
    padding: 60rpx 0;
    color: #999;
    font-size: 28rpx;
  }