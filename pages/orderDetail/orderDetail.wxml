<view class="order-detail">
  <view class="header">
    <text>订单号：{{order.id}}</text>
    <text class="date">{{order.date}}</text>
  </view>
  <view class="list">
    <view class="row header">
      <text>商品</text>
      <text>单价</text>
      <text>数量</text>
      <text>小计</text>
    </view>
    <view class="row" wx:for="{{order.products}}" wx:key="name">
      <text class="name">{{item.name}}</text>
      <text>{{item.priceStr}}</text>
      <text>x {{item.quantity}}</text>
      <text>{{item.subtotalStr}}</text>
    </view>
  </view>
  <view class="footer">
    <text>总计：<text class="amount">{{order.totalStr}}</text></text>
    <button class="appeal-btn" bindtap="goAppeal">申诉</button>
  </view>
</view>
